# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp

# Node (if you ever add tooling)
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Local environment / secrets
.env
.env.local
*.pem

# Build / cache artifacts
dist/
build/
.cache/

# Logs
*.log

# Local backup / scratch files
*.bak
*~
data_Bk.js
data_Enhanced_*.js

# Generated by photo_targets.mjs; regenerate rather than commit
photo_targets.json
photo_refetch.json

# Compiled by swiftc from facecrop.swift
facecrop

# Generated by the roster expansion tools; regenerate rather than commit
roster_missing.json
roster_candidates.json
roster_picks.json

# Python bytecode. These were tracked, and they rewrite themselves every time
# a script imports fetch_photos, so the working tree came up dirty for no
# reason anyone had caused.
__pycache__/
*.pyc

# Face crops are build input, not something the site serves: only
# atlas.jpg reaches the browser. Regenerate with facecrop before
# build_atlas.py — see README. Keeping 2,325 of them in git cost 58 MB and
# a fresh blob every time the crop parameters changed.
photos/faces/
